# Copy to .env and customize. CLI options override these values.
# Blank explicitly blocks an inherited shell key.
OPENAI_API_KEY=
HARNESS_MODEL=gpt-5-mini
HARNESS_REPO=fixtures/inclusive_sum
HARNESS_TASK="Fix the bug exposed by the existing tests. Preserve tests."
# Blank creates a fresh runs/<id> directory.
HARNESS_OUTPUT=
HARNESS_IMAGE=agent-harness-exec:local
HARNESS_CHECK="python -m unittest discover -v"
HARNESS_MAX_TURNS=16
HARNESS_MAX_TOOLS=30
HARNESS_MAX_SECONDS=180
HARNESS_COMMAND_SECONDS=30
HARNESS_OUTPUT_BYTES=16000
HARNESS_MAX_OUTPUT_TOKENS=2048

# Delegation is enabled only by --delegate; total children per run (concurrency is 1).
HARNESS_MAX_CHILDREN=2
